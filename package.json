{
  "name": "sai-pujitha-portfolio-backend",
  "version": "1.0.0",
  "description": "Backend server for J. Sai Pujitha's portfolio website",
  "main": "server.js",
  "scripts": {
    "start": "node routes/server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "echo 'No build step required for Node.js backend'",
    "logs:clear": "rm -rf logs/*.json",
    "setup": "npm install && node setup.js"
